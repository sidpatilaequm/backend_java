# Copy this file to server-db.env and fill in the real password (ask Mayank for it).
# server-db.env is gitignored — it will never be committed.
#
# Used by scripts/run-with-server-db.sh to point this service at the PRODUCTION database
# on the server instead of your local MySQL. Requires the read-only-forwarding SSH tunnel
# (../connect-server-db.sh at the aqqum root) to be running first.

DB_URL=jdbc:mysql://127.0.0.1:3307/multimedia_governance
DB_USERNAME=root
DB_PASSWORD=REPLACE_ME
